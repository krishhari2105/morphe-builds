      "cli_repo": "MorpheApp/morphe-desktop",
      "patches_asset_regex": "^patches-[^/]+\\.mpp$",
      "cli_asset_regex": "^morphe-desktop-[^/]+-all\\.jar$",
      "channel": "stable",
      "scheduled": true,
      "apps": ["youtube", "yt-music", "reddit"]
    },
    "morphe-dev": {
      "name": "Morphe development",
